datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  nama      String
  password  String
  role      String      @default("user") // "user" atau "admin"
  transaksi Transaksi[] // Relasi One-to-Many ke Transaksi
}

model Transaksi {
  id         Int      @id @default(autoincrement())
  judul      String
  jumlah     Float
  jenis      String   // "pemasukan" atau "pengeluaran"
  kategori   String
  tanggal    DateTime @default(now())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}